{
  "name": "redome-cz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web Redome.cz – Reiki a terapeutické služby (Karel Háněl)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && astro sync",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,jsx,md,mdx,json,css}\"",
    "lint": "npm run lint:prettier && npm run lint:eslint && npm run lint:astro",
    "lint:prettier": "prettier --check \"**/*.{astro,ts,tsx,js,jsx,md,mdx,json,css}\"",
    "lint:eslint": "eslint . --ext .ts,.tsx,.js,.mjs,.astro",
    "lint:astro": "astro check",
    "test": "echo \"(zatím žádné testy)\" && exit 0"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1"
  }
}

# =====================================================================
# Redome.cz – Apache konfigurace
# Tento soubor se kopíruje 1:1 do dist/ a nahrává na hosting.
# Komentáře česky, ať tomu rozumí kdokoli, kdo se k tomu dostane.
# =====================================================================

# Plná varianta (vypne directory listing i content negotiation podle přípony).
# Wedos.cz neumožňuje měnit MultiViews → zakomentováno, kdyby projekt
# přešel na jiný hosting, lze vrátit.
# Options -Indexes -MultiViews

# Wedos a jiné sdílené hostingy – povolen jen zákaz directory listingu.
Options -Indexes

AddDefaultCharset UTF-8
DirectoryIndex index.html
ServerSignature Off

# ---------------------------------------------------------------------
# Přesměrování domén:
#   nahled.redome.cz (stage)  → vždy https
#   www.redome.cz   (produkce) → vždy https (kanonická)
#   redome.cz       (naked)   → 301 na https://www.redome.cz/…
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Naked doména redome.cz → www.redome.cz (kanonická produkční doména)
  #    Provede se před https redirektem, aby uživatel doletěl jedním 301.
  RewriteCond %{HTTP_HOST} ^redome\.cz$ [NC]
  RewriteRule ^(.*)$ https://www.redome.cz/$1 [R=301,L]

  # 2) Vše ostatní (www.redome.cz, nahled.redome.cz) → vynutíme https.
  #    %{HTTP:X-Forwarded-Proto} je tu kvůli reverse proxy (Wedos LB).
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # -----------------------------------------------------------------
  # Content negotiation: pokud klient žádá Markdown, podsuneme `.md`
  # variantu místo HTML. Funguje pro:
  #   /co-je-reiki        → /co-je-reiki.md   (pokud existuje)
  #   /sluzby/reiki       → /sluzby/reiki.md
  # -----------------------------------------------------------------
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.md -f
  RewriteRule ^(.+?)/?$ /$1.md [L]

  # Hezké URL: /o-nas → /o-nas/index.html (Astro generuje s indexem)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(html|md|xml|txt|json|webmanifest|js|css|png|jpe?g|webp|svg|ico|woff2?|ttf|otf|pdf|map)$ [NC]
  RewriteRule ^(.*?)/?$ /$1.html [L]
</IfModule>

# ---------------------------------------------------------------------
# MIME typy (pro jistotu i přes mod_mime)
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/markdown          .md
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml          .svg
  AddType font/woff2             .woff2
  AddType font/woff              .woff
</IfModule>

# ---------------------------------------------------------------------
# Bezpečnostní hlavičky + cache strategie
# (mod_headers stačí, mod_expires zrušen – jeden zdroj pravdy)
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  # === Bezpečnostní hlavičky ===
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Web nepotřebuje žádné z těchto API – explicitní zákaz chrání před
  # extensions a případnými 3rd party skripty. Zároveň anti-tracking
  # direktivy proti Google FLoC / Topics / Attribution Reporting API.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=(), browsing-topics=(), attribution-reporting=()"

  # HSTS úmyslně nevynucujeme – u laiků dělá medvědí službu:
  # prohlížeč si pamatuje, že doména je „jen https" a kdyby zákazník
  # někdy potřeboval otevřít http:// (např. lokální preview, migrace
  # na jiný cert), bez vyčištění state se to neudělá.
  # https → vynucené přes mod_rewrite výše, to stačí.
  # Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" env=HTTPS

  # CSP – uvolněno pro Astro (inline styly), zpřísnit po nasazení
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  # === Cache strategie ===
  # Pravidla jdou od nejspecifičtějšího po obecné – setifempty zajistí,
  # že už nastavený Cache-Control nepřepíše obecnější FilesMatch.

  # 1) Astro fingerprintované assety v /_astro/ → 1 rok + immutable.
  #    Astro generuje názvy s hashem (např. hero-hp.EetaBH_z.webp).
  #    Při změně zdroje se hash mění → cache je bezpečně immutable.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # 2) CSS / JS / fonty mimo /_astro/ (favicon, fonty v public/) → 30 dní
  <FilesMatch "\.(css|js|woff|woff2|ttf|otf|eot)$">
    Header setifempty Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # 3) Obrázky a SVG mimo /_astro/ → 120 dní
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|svgz|ico)$">
    Header setifempty Cache-Control "public, max-age=10368000"
  </FilesMatch>

  # 4) Dokumenty (PDF, kancelář, ZIP) → 30 dní
  <FilesMatch "\.(pdf|doc|docx|xls|xlsx|ppt|pptx|zip)$">
    Header setifempty Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # 5) HTML → 5 minut + must-revalidate (rychlé promítnutí změn obsahu)
  <FilesMatch "\.html$">
    Header setifempty Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # 6) Markdown varianty stránek → 1 hodina + Vary: Accept
  #    (Accept header rozhoduje, jestli klient dostane HTML nebo MD)
  <FilesMatch "\.md$">
    Header set Cache-Control "public, max-age=3600"
    Header set Vary "Accept"
  </FilesMatch>

  # 7) sitemap.xml / llms*.txt / robots.txt → 1 hodina
  <FilesMatch "^(sitemap\.xml|llms.*\.txt|robots\.txt)$">
    Header setifempty Cache-Control "public, max-age=3600"
  </FilesMatch>

  # 8) 404 stránka – nikdy neindexovat (kdyby ji crawler chytil přímo)
  <FilesMatch "^404\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>

  # CORS pro fonty (kdyby je někdo embedoval z jiné domény / preview)
  <FilesMatch "\.(woff2?|ttf|otf|eot)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Vary: Accept-Encoding kvůli gzip/brotli
  Header append Vary "Accept-Encoding"
</IfModule>

# ---------------------------------------------------------------------
# Komprese (gzip + brotli, pokud je modul k dispozici)
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
  AddOutputFilterByType DEFLATE text/markdown
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS application/manifest+json image/svg+xml
  AddOutputFilterByType BROTLI_COMPRESS text/markdown
</IfModule>

# ---------------------------------------------------------------------
# Citlivé soubory zvenku nedostupné
# ---------------------------------------------------------------------

# Skryté soubory (.git, .htaccess, …)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Zálohy a temp soubory editorů (~, .bak, .backup, .swp, .swo, .orig, .old)
<FilesMatch "(~|\.(bak|backup|swp|swo|orig|old|tmp))$">
  Require all denied
</FilesMatch>

# Composer / npm / lock soubory – kdyby je někdo omylem nahrál
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml)$">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------------------
# 404 stránka (Astro ji generuje jako /404.html)
# ---------------------------------------------------------------------
ErrorDocument 404 /404.html

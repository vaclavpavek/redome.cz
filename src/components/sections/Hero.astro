---
import Button from '~/components/ui/Button.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <img src="/images/hero-hp.jpg" alt="" loading="eager" fetchpriority="high" />
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <h1 id="hero-title" class="hero__title">
        Najděte rovnováhu<br />těla i mysli
      </h1>
      <p class="hero__lead">
        Vítejte na stránkách věnovaných životu v souladu – se sebou samým
        i s okolním světem.
      </p>
      <div class="hero__actions">
        <Button href="/kontakt#formular" variant="soft" color="primary">Rezervovat termín</Button>
        <Button variant="outline" color="secondary" href="/co-je-reiki">
          <span class="hero__btn-white">Zjistit více</span>
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    color: var(--color-white);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    display: block;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Tmavě zelená pouze přes ~levou polovinu – pravá část odhalí ilustraci */
    background: linear-gradient(
      75deg,
      var(--color-primary-dark) 8%,
      var(--color-primary) 50%,
      color-mix(in srgb, var(--color-primary) 50%, transparent) 70%,
      transparent 91%
    );
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    align-items: center;
    min-height: 70vh;
    padding-block: var(--space-7) var(--space-6);
  }
  .hero__title {
    color: var(--color-white);
    font-size: clamp(2.25rem, 5vw, var(--text-h1));
    margin-bottom: var(--space-2);
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.25);
  }
  .hero__lead {
    font-size: var(--text-18);
    line-height: var(--leading-relaxed);
    color: var(--color-gray-100);
    max-width: 36rem;
    margin-bottom: var(--space-3);
  }
  .hero__actions {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }
  .hero__btn-white {
    color: var(--color-white);
  }
  @media (min-width: 1024px) {
    .hero__content {
      max-width: 40rem;
    }
  }
</style>

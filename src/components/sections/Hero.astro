---
import { Image } from 'astro:assets';
import Button from '~/components/ui/Button.astro';
import heroImg from '~/assets/images/hero-hp.jpg';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <Image
      src={heroImg}
      alt=""
      widths={[800, 1200, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      format="webp"
    />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <h1 id="hero-title" class="hero__title">
        Najděte rovnováhu<br />těla i mysli
      </h1>
      <p class="hero__lead">
        Vítejte na stránkách věnovaných životu v souladu – se sebou samým i s okolním světem.
      </p>
      <div class="hero__actions">
        <Button href="#formular" variant="soft" color="primary">Objednat terapii</Button>
        <Button variant="outline" color="secondary" href="/co-je-reiki">
          <span class="hero__btn-white">Zjistit více</span>
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    color: var(--color-white);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Image native 2400×563 (aspect 4.26). Hero ~1440×600 (aspect 2.4).
       Cover scaling škáluje image podle výšky (height fills hero), pak
       ho center-zarovná – tím vidíme střední ~56 % obrazu, což pokrývá
       celý motiv: páteř, záři, ruku i masérku.  */
    object-position: center center;
    display: block;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Overlay přes ~levou polovinu – pravá část odhalí ilustraci */
    background: linear-gradient(
      to right,
      var(--color-primary-dark) 0%,
      var(--color-primary) 28%,
      color-mix(in srgb, var(--color-primary) 55%, transparent) 42%,
      transparent 56%
    );
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    align-items: center;
    /* 50vh ladí s aspect ratio image (2400×563 = 4.26). Větší výška
       by cover-scale zvětšila image a oříznula bočky (páteř / postavu). */
    min-height: 50vh;
    padding-block: var(--space-6) var(--space-5);
  }
  .hero__title {
    color: var(--color-white);
    font-size: clamp(2.25rem, 5vw, var(--text-h1));
    margin-bottom: var(--space-2);
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.3);
  }
  .hero__lead {
    font-size: var(--text-18);
    line-height: var(--leading-relaxed);
    color: var(--color-gray-100);
    max-width: 36rem;
    margin-bottom: var(--space-3);
  }
  .hero__actions {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }
  .hero__btn-white {
    color: var(--color-white);
  }
  @media (min-width: 1024px) {
    .hero__content {
      max-width: 40rem;
    }
  }
</style>

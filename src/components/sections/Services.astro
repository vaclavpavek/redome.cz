---
import { getCollection } from 'astro:content';
import Lotus from '~/components/ui/icons/Lotus.astro';
import Icon from '~/components/ui/Icon.astro';
import ArrowRight from '~/components/ui/icons/ArrowRight.astro';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section class="services" aria-labelledby="services-title">
  <div class="container">
    <header class="services__header">
      <h2 id="services-title">Terapeutické služby</h2>
      <p class="services__subtitle">Individuální přístup k vašemu zdraví a pohodě</p>
    </header>

    <div class="services__grid">
      {
        services.map((service) => (
          <article class="service-card">
            <Icon size={36} class="service-card__icon">
              <Lotus />
            </Icon>
            <h3 class="service-card__title">{service.data.title}</h3>
            <p class="service-card__summary">{service.data.summary}</p>
            {service.data.duration && (
              <p class="service-card__meta">Délka: {service.data.duration}</p>
            )}
            <a href={`/${service.id}`} class="service-card__link">
              Více informací
              <Icon size={16}><ArrowRight /></Icon>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: var(--space-6);
    background: var(--color-gray-100);
  }
  .services__header {
    text-align: center;
    margin-bottom: var(--space-4);
  }
  .services__subtitle {
    font-style: italic;
    color: var(--color-gray-700);
    margin: 0;
  }
  .services__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }
  .service-card {
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    transition:
      transform var(--duration-base) var(--easing-base),
      box-shadow var(--duration-base) var(--easing-base);
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-sm);
  }
  .service-card__icon {
    color: var(--color-primary);
  }
  .service-card__title {
    font-size: var(--text-h4);
    margin: 0;
  }
  .service-card__summary {
    color: var(--color-gray-700);
    margin: 0;
    flex-grow: 1;
  }
  .service-card__meta {
    font-size: var(--text-14);
    color: var(--color-gray-600);
    margin: 0;
  }
  .service-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
    margin-top: var(--space-1);
  }
  .service-card__link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }
  @media (min-width: 768px) {
    .services__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

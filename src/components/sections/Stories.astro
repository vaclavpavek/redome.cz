---
import { getCollection, render } from 'astro:content';

const stories = (await getCollection('stories')).sort(
  (a, b) => a.data.order - b.data.order
);

const storiesWithContent = await Promise.all(
  stories.map(async (story) => {
    const { Content } = await render(story);
    return { ...story, Content };
  })
);
---

<section class="stories" aria-labelledby="stories-title">
  <div class="container">
    <header class="stories__header">
      <h2 id="stories-title">Příběhy z praxe</h2>
    </header>

    <div
      class="stories__carousel"
      role="region"
      aria-roledescription="carousel"
      aria-label="Reference klientů"
      data-stories
    >
      {
        storiesWithContent.map((story, index) => (
          <article
            class="story"
            role="group"
            aria-roledescription="slide"
            aria-label={`Příběh ${index + 1} z ${storiesWithContent.length}: ${story.data.author}`}
            aria-hidden={index !== 0 ? 'true' : undefined}
            data-story-slide
            data-active={index === 0 ? 'true' : 'false'}
          >
            <blockquote class="story__quote">
              <story.Content />
            </blockquote>
            <footer class="story__attribution">
              — {story.data.author}{story.data.location && `, ${story.data.location}`}
            </footer>
          </article>
        ))
      }
    </div>

    {
      storiesWithContent.length > 1 && (
        <div class="stories__controls">
          <button type="button" class="stories__btn" data-stories-prev aria-label="Předchozí příběh">‹</button>
          <div class="stories__dots" role="tablist" aria-label="Vybrat příběh">
            {storiesWithContent.map((_, index) => (
              <button
                type="button"
                class="stories__dot"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-label={`Příběh ${index + 1}`}
                data-stories-dot
                data-index={index}
              />
            ))}
          </div>
          <button type="button" class="stories__btn" data-stories-next aria-label="Další příběh">›</button>
        </div>
      )
    }
  </div>
</section>

<style>
  .stories {
    padding-block: var(--space-6);
    background:
      linear-gradient(180deg, var(--color-white) 0%, var(--color-gray-100) 100%);
  }
  .stories__header {
    text-align: center;
    margin-bottom: var(--space-3);
  }
  .stories__carousel {
    position: relative;
    background: var(--color-white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: var(--space-3);
    min-height: 12rem;
  }
  .story {
    display: none;
  }
  .story[data-active='true'] {
    display: block;
  }
  .story__quote {
    margin: 0;
    color: var(--color-gray-800);
    font-size: var(--text-18);
    line-height: var(--leading-relaxed);
  }
  .story__attribution {
    margin-top: var(--space-1);
    color: var(--color-gray-600);
    font-style: italic;
  }
  .stories__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .stories__btn {
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-gray-300);
    background: var(--color-white);
    border-radius: var(--radius-full);
    cursor: pointer;
    font-size: 1.5rem;
    color: var(--color-primary);
    transition:
      background var(--duration-fast) var(--easing-base),
      border-color var(--duration-fast) var(--easing-base);
  }
  .stories__btn:hover {
    background: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
  }
  .stories__dots {
    display: flex;
    gap: 0.5rem;
  }
  .stories__dot {
    width: 10px;
    height: 10px;
    border: 0;
    border-radius: 50%;
    background: var(--color-gray-300);
    cursor: pointer;
    padding: 0;
  }
  .stories__dot[aria-selected='true'] {
    background: var(--color-primary);
    transform: scale(1.3);
  }
</style>

<script>
  // Jednoduchý karusel – ovládání tlačítky, klávesnicí (šipky) a tečkami,
  // s ohledem na prefers-reduced-motion (žádné animace, jen přepnutí).
  const root = document.querySelector<HTMLElement>('[data-stories]');
  if (root) {
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>('[data-story-slide]')
    );
    const dots = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-stories-dot]')
    );
    const prev = document.querySelector<HTMLButtonElement>('[data-stories-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-stories-next]');
    let index = 0;

    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        s.dataset.active = n === index ? 'true' : 'false';
        if (n === index) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, n) => {
        d.setAttribute('aria-selected', n === index ? 'true' : 'false');
      });
    };

    prev?.addEventListener('click', () => show(index - 1));
    next?.addEventListener('click', () => show(index + 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const target = Number(dot.dataset.index);
        if (!Number.isNaN(target)) show(target);
      });
    });

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      else if (e.key === 'ArrowRight') show(index + 1);
    });
  }
</script>

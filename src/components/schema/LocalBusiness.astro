---
import { SITE, CONTACT } from '~/lib/site';
import { addSchema } from '~/lib/schema';

/**
 * Globální schema.org LocalBusiness (HealthAndBeautyBusiness).
 * Vykreslit jednou v BaseLayout – data se sloučí v JsonLdGraph.
 */

addSchema(Astro.locals, {
  '@type': 'HealthAndBeautyBusiness',
  '@id': `${SITE.url}#business`,
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  telephone: CONTACT.phone,
  email: CONTACT.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${CONTACT.address.street}`,
    addressLocality: CONTACT.address.city,
    postalCode: CONTACT.address.zip,
    addressCountry: CONTACT.address.country,
  },
  makesOffer: [
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Reiki' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Dornova metoda' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Breussova masáž' } },
  ],
  founder: {
    '@type': 'Person',
    name: CONTACT.person,
  },
});
---

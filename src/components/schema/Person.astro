---
import { SITE } from '~/lib/site';
import { addSchema } from '~/lib/schema';

interface Props {
  name: string;
  jobTitle: string;
  description?: string;
  knowsAbout?: string[];
}

const { name, jobTitle, description, knowsAbout } = Astro.props;

addSchema(Astro.locals, {
  '@type': 'Person',
  name,
  jobTitle,
  ...(description && { description }),
  ...(knowsAbout && { knowsAbout }),
  worksFor: { '@id': `${SITE.url}#business` },
});
---

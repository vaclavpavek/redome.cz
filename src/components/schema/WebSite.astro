---
import JsonLd from '~/components/seo/JsonLd.astro';
import { SITE } from '~/lib/site';

const data = {
  '@type': 'WebSite',
  '@id': `${SITE.url}#website`,
  url: SITE.url,
  name: SITE.name,
  description: SITE.description,
  inLanguage: SITE.lang,
  publisher: { '@id': `${SITE.url}#business` },
};
---

<JsonLd data={data} />

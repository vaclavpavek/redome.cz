---
import { SITE } from '~/lib/site';
import { addSchema } from '~/lib/schema';

addSchema(Astro.locals, {
  '@type': 'WebSite',
  '@id': `${SITE.url}#website`,
  url: SITE.url,
  name: SITE.name,
  description: SITE.description,
  inLanguage: SITE.lang,
  publisher: { '@id': `${SITE.url}#business` },
});
---

---
import { SITE } from '~/lib/site';
import { addSchema } from '~/lib/schema';

interface Props {
  name: string;
  description: string;
  serviceType?: string;
  slug?: string;
}

const { name, description, serviceType, slug } = Astro.props;

addSchema(Astro.locals, {
  '@type': 'Service',
  name,
  description,
  serviceType: serviceType ?? name,
  provider: { '@id': `${SITE.url}#business` },
  areaServed: { '@type': 'Country', name: 'Česká republika' },
  ...(slug && { url: `${SITE.url}/${slug}` }),
});
---

---
import { SITE } from '~/lib/site';
import { addSchema } from '~/lib/schema';

interface Crumb {
  name: string;
  url: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

addSchema(Astro.locals, {
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.url, SITE.url).href.replace(/\/$/, ''),
  })),
});
---

---
interface Props {
  variant?: 'default' | 'inverse';
  href?: string | false;
  class?: string;
}

const { variant = 'default', href = '/', class: className = '' } = Astro.props;

// Logo SVG je v /public — varianta default je tmavá pro světlé pozadí,
// inverse je světlá pro tmavé pozadí (např. patička).
const src = variant === 'inverse' ? '/logo-inverse.svg' : '/logo.svg';
const classes = `logo ${className}`.trim();
const alt = 'Redome.cz – domů';
---

{
  href === false ? (
    <span class={classes}>
      <img src={src} alt={alt} class="logo__img" />
    </span>
  ) : (
    <a href={href} class={classes} aria-label={alt}>
      <img src={src} alt="" class="logo__img" />
    </a>
  )
}

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    flex-shrink: 0;
  }
  .logo__img {
    height: 2.5rem;
    width: auto;
    max-width: none;
    min-width: 9.5rem;
    display: block;
  }
  @media (min-width: 1024px) {
    .logo__img {
      height: 3rem;
      min-width: 11.5rem;
    }
  }
</style>

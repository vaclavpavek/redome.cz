---
interface Props {
  variant?: 'default' | 'inverse';
  href?: string | false;
  class?: string;
}

const { variant = 'default', href = '/', class: className = '' } = Astro.props;
const markSrc =
  variant === 'inverse' ? '/logo-mark-inverse.svg' : '/logo-mark.svg';
const classes = `logo logo--${variant} ${className}`.trim();
const alt = 'Redome.cz – domů';
---

{
  href === false ? (
    <span class={classes}>
      <img src={markSrc} alt="" class="logo__mark" />
      <span class="logo__wordmark">Redome</span>
    </span>
  ) : (
    <a href={href} class={classes} aria-label={alt}>
      <img src={markSrc} alt="" class="logo__mark" />
      <span class="logo__wordmark">Redome</span>
    </a>
  )
}

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    line-height: 1;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo__mark {
    width: 2.5rem;
    height: 1.7rem;
    flex-shrink: 0;
    display: block;
  }
  .logo__wordmark {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .logo--default .logo__wordmark {
    color: var(--color-primary-dark);
  }
  .logo--inverse .logo__wordmark {
    color: var(--color-white);
  }
  @media (min-width: 1024px) {
    .logo__mark {
      width: 3rem;
      height: 2rem;
    }
    .logo__wordmark {
      font-size: 2.5rem;
    }
  }
</style>

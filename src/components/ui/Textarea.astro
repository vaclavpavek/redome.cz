---
interface Props {
  id: string;
  name: string;
  label: string;
  placeholder?: string;
  value?: string;
  rows?: number;
  required?: boolean;
  helperText?: string;
  error?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  placeholder,
  value,
  rows = 5,
  required,
  helperText,
  error,
  class: className = '',
} = Astro.props;

const describedBy =
  [helperText ? `${id}-helper` : null, error ? `${id}-error` : null].filter(Boolean).join(' ') ||
  undefined;
---

<div class={`field ${error ? 'field--error' : ''} ${className}`.trim()}>
  <label for={id} class="field__label">
    {label}{
      required && (
        <span aria-hidden="true" class="field__required">
          *
        </span>
      )
    }
  </label>
  <textarea
    id={id}
    name={name}
    placeholder={placeholder}
    rows={rows}
    required={required}
    aria-required={required ? 'true' : undefined}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy}
    class="field__input field__input--textarea"
    set:html={value ?? ''}
  />
  {
    helperText && (
      <p id={`${id}-helper`} class="field__helper">
        {helperText}
      </p>
    )
  }
  {
    error && (
      <p id={`${id}-error`} class="field__error" role="alert">
        {error}
      </p>
    )
  }
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .field__label {
    font-size: var(--text-12);
    font-weight: 500;
    color: var(--color-gray-700);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .field__required {
    color: var(--color-danger);
    margin-left: 0.25rem;
  }
  .field__input {
    font-family: var(--font-body);
    font-size: var(--text-16);
    line-height: var(--leading-normal);
    color: var(--color-text);
    background: var(--color-white);
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-sm);
    padding: 0.625rem 0.875rem;
    width: 100%;
    transition:
      border-color var(--duration-fast) var(--easing-base),
      box-shadow var(--duration-fast) var(--easing-base);
  }
  .field__input--textarea {
    min-height: 7rem;
    resize: vertical;
  }
  .field__input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 25%, transparent);
    outline: none;
  }
  .field__input::placeholder {
    color: var(--color-gray-500);
  }
  .field--error .field__input {
    border-color: var(--color-danger);
  }
  .field__helper {
    font-size: var(--text-12);
    color: var(--color-gray-600);
    margin: 0;
  }
  .field__error {
    font-size: var(--text-12);
    color: var(--color-danger);
    margin: 0;
  }
</style>

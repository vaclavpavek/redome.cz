---
import { CONTACT, FOOTER_NAV, SITE } from '~/lib/site';
import Logo from '~/components/ui/Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__col site-footer__col--brand">
      <Logo variant="inverse" />
      <p class="site-footer__tagline">{SITE.tagline}</p>
    </div>

    <nav class="site-footer__col" aria-label="Patička – navigace">
      <h2 class="site-footer__heading">Navigace</h2>
      <ul class="site-footer__list">
        {FOOTER_NAV.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">{CONTACT.person}</h2>
      <ul class="site-footer__list">
        <li>IČO: {CONTACT.ico}</li>
        <li>
          <a href={CONTACT.phoneHref}>{CONTACT.phone}</a>
        </li>
        <li>
          <a href={CONTACT.emailHref}>{CONTACT.email}</a>
        </li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Mluvte / pište</h2>
      <ul class="site-footer__list">
        <li>
          <a href={CONTACT.phoneHref}>{CONTACT.phone}</a>
        </li>
        <li>
          <a href={CONTACT.emailHref}>{CONTACT.email}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <small>© {year} {SITE.name}. Všechna práva vyhrazena.</small>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary-dark);
    color: var(--color-white);
    padding-block: var(--space-5) var(--space-3);
    margin-top: var(--space-8);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  .site-footer__col--brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .site-footer__tagline {
    color: var(--color-secondary-light);
    font-style: italic;
    margin: 0;
  }
  .site-footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-16);
    font-weight: 700;
    color: var(--color-secondary);
    margin: 0 0 var(--space-1);
  }
  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .site-footer__list a {
    color: var(--color-white);
    text-decoration: none;
  }
  .site-footer__list a:hover {
    color: var(--color-secondary);
    text-decoration: underline;
  }
  .site-footer__bottom {
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid color-mix(in srgb, var(--color-white) 15%, transparent);
    color: var(--color-secondary-light);
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .site-footer__inner {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
  }
</style>

---
import { CONTACT, CONTACT_SECONDARY, CREDITS, FOOTER_NAV, SITE } from '~/lib/site';
import Logo from '~/components/ui/Logo.astro';
import Icon from '~/components/ui/Icon.astro';
import Phone from '~/components/ui/icons/Phone.astro';
import Envelope from '~/components/ui/icons/Envelope.astro';

const year = new Date().getFullYear();
const fullAddress = `${CONTACT.address.street}, ${CONTACT.address.city} ${CONTACT.address.zip}`;
---

<footer class="site-footer">
  <div class="site-footer__bg" aria-hidden="true"></div>

  <div class="container site-footer__inner">
    <div class="site-footer__col site-footer__col--brand">
      <Logo variant="inverse" />
    </div>

    <nav class="site-footer__col" aria-label="Patička – navigace">
      <h2 class="site-footer__heading">Navigace</h2>
      <ul class="site-footer__list">
        {FOOTER_NAV.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">{CONTACT.person}</h2>
      <address class="site-footer__list">
        <p class="site-footer__row">
          <Icon size={16}><Envelope /></Icon>
          <span>{fullAddress}</span>
        </p>
        <p class="site-footer__row">
          <Icon size={16}><Phone /></Icon>
          <a href={CONTACT.phoneHref}>{CONTACT.phone}</a>
        </p>
        <p class="site-footer__row">
          <Icon size={16}><Envelope /></Icon>
          <a href={CONTACT.emailHref}>{CONTACT.email}</a>
        </p>
      </address>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">{CONTACT_SECONDARY.person}</h2>
      <address class="site-footer__list">
        <p class="site-footer__row">
          <Icon size={16}><Phone /></Icon>
          <a href={CONTACT_SECONDARY.phoneHref}>{CONTACT_SECONDARY.phone}</a>
        </p>
        <p class="site-footer__row">
          <Icon size={16}><Envelope /></Icon>
          <a href={CONTACT_SECONDARY.emailHref}>{CONTACT_SECONDARY.email}</a>
        </p>
      </address>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <small>© {year} {SITE.name}</small>
    <small class="site-footer__credit">
      Vytvořil
      {
        CREDITS.authors.map((author, index) => (
          <>
            <a href={author.url} target="_blank" rel="noopener noreferrer">
              {author.name}
            </a>
            {index < CREDITS.authors.length - 2 ? ', ' : ''}
            {index === CREDITS.authors.length - 2 ? ' a ' : ''}
          </>
        ))
      }
    </small>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--color-primary-dark);
    color: var(--color-white);
    padding-block: var(--space-5) var(--space-3);
    isolation: isolate;
    overflow: hidden;
    /* Žádný margin-top – jinak vznikne bílá mezera mezi sekcí webu a patičkou */
  }
  /* Velký lotusový vzor jako pozadí (opacity 0.1, primary barva) */
  .site-footer__bg {
    position: absolute;
    left: -3rem;
    bottom: -2rem;
    width: 22rem;
    height: 22rem;
    background: url('/footer-mark.svg') no-repeat center / contain;
    pointer-events: none;
    z-index: 0;
  }
  .site-footer > .container {
    position: relative;
    z-index: 1;
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  .site-footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-16);
    font-weight: 700;
    color: var(--color-secondary);
    margin: 0 0 var(--space-1);
  }
  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-style: normal;
  }
  .site-footer__list a {
    color: var(--color-white);
    text-decoration: none;
  }
  .site-footer__list a:hover {
    color: var(--color-secondary);
    text-decoration: underline;
  }
  .site-footer__row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--color-white);
  }
  .site-footer__row :global(.icon) {
    color: var(--color-secondary);
  }
  .site-footer__bottom {
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid color-mix(in srgb, var(--color-white) 15%, transparent);
    color: var(--color-secondary-light);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1);
  }
  .site-footer__credit a {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 500;
  }
  .site-footer__credit a:hover {
    color: var(--color-secondary);
  }
  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .site-footer__inner {
      grid-template-columns: 1.2fr 1fr 1.4fr 1.2fr;
    }
  }
</style>

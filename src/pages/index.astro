---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/sections/Hero.astro';
import IntroServices from '~/components/sections/IntroServices.astro';
import WhatIsReiki from '~/components/sections/WhatIsReiki.astro';
import Services from '~/components/sections/Services.astro';
import Masters from '~/components/sections/Masters.astro';
import Stories from '~/components/sections/Stories.astro';
import ContactForm from '~/components/sections/ContactForm.astro';
import { SITE } from '~/lib/site';
---

<BaseLayout title={`${SITE.name} – ${SITE.tagline}`} description={SITE.description}>
  <Hero />
  <IntroServices />
  <WhatIsReiki />
  <Services />
  <Masters />
  <Stories />
  <ContactForm />
</BaseLayout>

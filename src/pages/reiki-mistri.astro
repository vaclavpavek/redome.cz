---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '~/layouts/PageLayout.astro';
import ContactForm from '~/components/sections/ContactForm.astro';
import masterImg from '~/assets/images/master-karel.jpg';

const masters = (await getCollection('masters')).sort((a, b) => a.data.order - b.data.order);

const mastersWithContent = await Promise.all(
  masters.map(async (master) => {
    const { Content } = await render(master);
    return { ...master, Content };
  })
);

const breadcrumbs = [
  { name: 'Domů', url: '/' },
  { name: 'Reiki mistři', url: '/reiki-mistri' },
];
---

<PageLayout
  title="Reiki mistři"
  description="Karel Háněl – Reiki Mistr/učitel (IV. stupeň). Praxe Reiki, Dornovy metody a Breussovy masáže v Litomyšli."
  breadcrumbs={breadcrumbs}
>
  <h1>Reiki mistři</h1>

  {
    mastersWithContent.map((master, index) => (
      <article class={`master ${index % 2 === 1 ? 'master--reverse' : ''}`}>
        <div class="master__photo">
          <Image
            src={masterImg}
            alt={`${master.data.name} – foto`}
            widths={[300, 450, 600]}
            sizes="(min-width: 768px) 40vw, 100vw"
            loading="lazy"
            format="webp"
          />
        </div>
        <div class="master__body">
          <header>
            <h2>{master.data.name}</h2>
            <p class="master__role">{master.data.role}</p>
          </header>
          <div class="master__bio">
            <master.Content />
          </div>
        </div>
      </article>
    ))
  }

  <Fragment slot="after">
    <ContactForm />
  </Fragment>
</PageLayout>

<style>
  .master {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-block: var(--space-5);
    align-items: start;
  }
  @media (min-width: 768px) {
    .master {
      grid-template-columns: 1fr 1.5fr;
    }
    .master--reverse {
      grid-template-columns: 1.5fr 1fr;
    }
    .master--reverse .master__photo {
      order: 2;
    }
  }
  .master__photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 3/4;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    display: block;
  }
  .master__body h2 {
    color: var(--color-primary-dark);
    margin: 0;
    font-size: var(--text-h3);
  }
  .master__role {
    font-style: italic;
    color: var(--color-gray-700);
    margin: 0.25rem 0 var(--space-2);
  }
  .master__bio {
    line-height: var(--leading-relaxed);
  }
</style>

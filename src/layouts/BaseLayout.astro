---
import '~/styles/global.css';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import BaseHead from '~/components/seo/BaseHead.astro';
import JsonLdGraph from '~/components/seo/JsonLdGraph.astro';
import LocalBusiness from '~/components/schema/LocalBusiness.astro';
import WebSite from '~/components/schema/WebSite.astro';
import { SITE } from '~/lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image, type, noindex } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead title={title} description={description} image={image} type={type} noindex={noindex} />
    <LocalBusiness />
    <WebSite />
    <slot name="head" />
    <JsonLdGraph />
  </head>
  <body>
    <a href="#main" class="skip-link">Přeskočit na obsah</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

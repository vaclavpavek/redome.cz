# ============================================================================
# Redome.cz – ukázka konfigurace prostředí
# ============================================================================
#
# Lokálně:
#   1) Zkopíruj tento soubor:  cp .env.example .env
#   2) Vyplň hodnoty (zejména SFTP_PASSWORD a API klíče, pokud je chceš).
#   3) `make dev` – proměnné si compose i devcontainer načte sám.
#
# GitHub Actions (CI/CD):
#   Tento soubor NEUKLÁDEJ jako secret. Sloupec "GitHub Secret" níže
#   říká, pod jakým názvem proměnnou v Settings → Secrets and variables
#   → Actions založit. Workflow ji pak čte přes ${{ secrets.NAZEV }}.
#
# Soubor .env je v .gitignore – do repa se nedostane.
# ============================================================================


# ----- Build (Astro) --------------------------------------------------------

# Absolutní URL pro canonical, OG, sitemap.xml, robots.txt, JSON-LD.
# Lokálně typicky nech http://localhost:4321 (nebo nech default).
# CI v GitHub Actions nastaví podle větve:
#   nahled → https://nahled.redome.cz
#   www    → https://www.redome.cz (default, dá se vynechat)
# GitHub Secret: SITE_URL (volitelně, jinak workflow odvodí)
SITE_URL=http://localhost:4321


# ----- Kontaktní formulář ---------------------------------------------------

# Kam chodí zprávy z /api/contact.php.
# V devu se vše chytá do Mailpitu (make mail), takže CONTACT_TO může být
# cokoli – v produkci ale musí být skutečná schránka.
# GitHub Secret: CONTACT_TO
CONTACT_TO=redome@redome.cz


# ----- SFTP deploy (GitHub Actions) -----------------------------------------

# Tyhle hodnoty potřebuje deploy workflow, aby nahrál dist/ na Wedos.
# Lokálně nejsou potřeba.
# GitHub Secrets: SFTP_HOST, SFTP_USER, SFTP_PASSWORD, SFTP_PATH
SFTP_HOST=ssh.wedos.net
SFTP_USER=
SFTP_PASSWORD=
# Kořen webu na hostingu:
#   nahled.redome.cz  →  /www/subdom/nahled
#   www.redome.cz     →  /www
SFTP_PATH=/www


# ----- AI nástroje (volitelné, jen pro vývoj) -------------------------------

# Claude Code v devcontaineru – přihlášení pak nemusíš dělat ručně.
# Klíč získáš na https://console.anthropic.com/.
# GitHub Secret: nepřidávat (CI je nepotřebuje).
ANTHROPIC_API_KEY=

# GitHub Copilot + gh CLI v devcontaineru.
# Token vygeneruj na https://github.com/settings/tokens
# (stačí scope `repo` a `read:user`).
# GitHub Secret: nepřidávat (uvnitř Actions je k dispozici GITHUB_TOKEN
# automaticky).
GITHUB_TOKEN=

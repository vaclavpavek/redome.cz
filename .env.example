# ============================================================================
# Redome.cz – konfigurace pro nasazení (GitHub Actions)
# ============================================================================
#
# Šablona pro GitHub Secrets. Každou proměnnou založ jako secret v
# Settings → Secrets and variables → Actions; workflow ji pak čte přes
# ${{ secrets.NAZEV }}.
#
# Lokálně tyhle hodnoty NEPOTŘEBUJEŠ – běh `make dev` si vystačí bez nich.
# Soubor .env je v .gitignore, NIKDY ho do repa nedávej (obsahuje heslo).
# ============================================================================

# ----- FTPS deploy -----------------------------------------------------------
# Nasazení dist/ na Wedos přes FTP-over-TLS (explicit FTPS, port 21).

FTP_HOST=ftp.wedos.net
FTP_USER=
FTP_PASSWORD=

# Base path na hostingu. Workflow k němu připojí název větve jako slug:
#   nahled  →  /www/subdom/nahled   (https://nahled.redome.cz)
#   www     →  /www/subdom/www      (https://www.redome.cz)
FTP_PATH=/www/subdom